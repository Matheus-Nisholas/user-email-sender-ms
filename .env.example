# Copie para .env e substitua os placeholders por senhas exclusivas. Nunca versione .env.
DB_USER=app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
USER_DB=users_db
EMAIL_DB=emails_db

RABBITMQ_USER=app
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

USER_PORT=8081
EMAIL_PORT=8082

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Configure o SMTP real apenas quando chegar à etapa de envio de e-mails.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
